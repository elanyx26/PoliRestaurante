# Copie este archivo a ".env" y complete los valores. NUNCA suba ".env" al repositorio.

# --- PostgreSQL ---
DB_URL=jdbc:postgresql://localhost:5432/restaurante
DB_USERNAME=postgres
DB_PASSWORD=cambiar-esta-contrasena

# --- JWT (mínimo 32 caracteres; genere uno con: openssl rand -base64 48) ---
JWT_SECRET=cambiar-por-un-secreto-largo-y-aleatorio-de-al-menos-32-caracteres
JWT_EXPIRATION_MINUTES=480

# --- Administrador inicial (solo se crea si no existen usuarios) ---
INITIAL_ADMIN_NAME=Administrador
INITIAL_ADMIN_EMAIL=admin@ejemplo.com
INITIAL_ADMIN_PASSWORD=cambiar-contrasena-segura

# --- Servidor ---
SERVER_PORT=8080
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
APP_TIMEZONE=America/Bogota
# Carpeta donde se guardan las fotos de los productos subidas desde el panel (solo con STORAGE_PROVIDER=local).
UPLOADS_DIR=./uploads

# --- Almacenamiento de fotos: local (carpeta) | db (en la base de datos) | r2 (Cloudflare R2) ---
# En servidores con disco efímero (Render, etc.) use db o r2.
STORAGE_PROVIDER=local
# Solo para STORAGE_PROVIDER=r2:
# R2_ENDPOINT=https://<ID-DE-CUENTA>.r2.cloudflarestorage.com
# R2_BUCKET=poli-fotos
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=

# --- Producción ---
# Apaga Swagger (la documentación interactiva de la API) cuando el backend es público.
# SWAGGER_ENABLED=false
# Tamaño del pool de conexiones a la base (5 alcanza para un servidor pequeño).
# DB_POOL_SIZE=5
