  "item": [
    {
      "name": "1. Pedidos (Mesa / Para Llevar)",
      "item": [
        {
          "name": "Listar Pedidos",
          "request": {
            "method": "GET",
            "header": [],
            "url": "http://localhost:8080/api/pedidos"
          }
        },
        {
          "name": "Crear Pedido",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"id_mesero\": 1,\n  \"id_mesa\": 1,\n  \"tipo_pedido\": \"En mesa\",\n  \"nombre_cliente\": \"Cliente Test\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "http://localhost:8080/api/pedidos"
          }
        },
        {
          "name": "Obtener Pedido por ID",
          "request": {
            "method": "GET",
            "header": [],
            "url": "http://localhost:8080/api/pedidos/1"
          }
        },
        {
          "name": "Eliminar Pedido",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": "http://localhost:8080/api/pedidos/1"
          }
        }
      ]
    },
    {
      "name": "2. Detalles del Pedido (Cocina / Productos)",
      "item": [
        {
          "name": "Agregar Producto a Pedido",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"id_pedido\": 1,\n  \"id_producto\": 1,\n  \"cantidad\": 2,\n  \"notas\": \"Sin cebolla\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "http://localhost:8080/api/detalles"
          }
        },
        {
          "name": "Listar Productos de un Pedido",
          "request": {
            "method": "GET",
            "header": [],
            "url": "http://localhost:8080/api/detalles?id_pedido=1"
          }
        },
        {
          "name": "Quitar Producto",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": "http://localhost:8080/api/detalles/1"
          }
        }
      ]
    }
