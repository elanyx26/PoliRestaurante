{
  "info": {
    "name": "PoliRestaurante API Simplificada",
    "schema": "https://getpostman.com"
  },
  "variable": [
    {
      "key": "puerto",
      "value": "8080",
      "description": "Cambia este número si tu backend corre en otro puerto (ej. 3000, 5000, etc.)"
    },
    {
      "key": "baseUrl",
      "value": "http://localhost:{{puerto}}"
    }
  ],
  "item": [
    {
      "name": "1. Pedidos (Mesa / Para Llevar)",
      "item": [
        {
          "name": "Listar Pedidos",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/pedidos",
              "host": ["{{baseUrl}}"],
              "path": ["api", "pedidos"]
            }
          }
        },
        {
          "name": "Crear Pedido",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"id_mesero\": 1,\n  \"id_mesa\": 1,\n  \"tipo_pedido\": \"En mesa\",\n  \"nombre_cliente\": \"Cliente Test\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{baseUrl}}/api/pedidos",
              "host": ["{{baseUrl}}"],
              "path": ["api", "pedidos"]
            }
          }
        },
        {
          "name": "Obtener Pedido por ID",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/pedidos/1",
              "host": ["{{baseUrl}}"],
              "path": ["api", "pedidos", "1"]
            }
          }
        },
        {
          "name": "Eliminar Pedido",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/pedidos/1",
              "host": ["{{baseUrl}}"],
              "path": ["api", "pedidos", "1"]
            }
          }
        }
      ]
    },
    {
      "name": "2. Detalles del Pedido (Cocina / Productos)",
      "item": [
        {
          "name": "Agregar Producto a Pedido",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"id_pedido\": 1,\n  \"id_producto\": 1,\n  \"cantidad\": 2,\n  \"notas\": \"Sin cebolla\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{baseUrl}}/api/detalles",
              "host": ["{{baseUrl}}"],
              "path": ["api", "detalles"]
            }
          }
        },
        {
          "name": "Listar Productos de un Pedido",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/detalles?id_pedido=1",
              "host": ["{{baseUrl}}"],
              "path": ["api", "detalles"],
              "query": [{ "key": "id_pedido", "value": "1" }]
            }
          }
        },
        {
          "name": "Quitar Producto",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/detalles/1",
              "host": ["{{baseUrl}}"],
              "path": ["api", "detalles", "1"]
            }
          }
        }
      ]
    }
  ]
}
